# VoiceOS-Own Configuration
# Replace with your official Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (e.g. gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Default Audio Configuration
DEFAULT_TTS_VOICE=default
DEFAULT_TTS_SPEED=1.2
AUDIO_DUCKING_ENABLED=true

# UI Configuration
THEME=dark
ENABLE_NOTCH=true
ENABLE_PILL=true
CLOSE_TO_TRAY=true
